#!/bin/bash
# Build a Fedora dev image on AWS, GCP, or both.
#   ./build aws               # base image (AMI)
#   ./build gcp --gpu         # GPU image (NVIDIA driver + CUDA + ML venvs) on GCP
#   ./build all               # both clouds
# Extra args after -- go to `packer build`, e.g.  ./build aws -- -var aws_region=us-west-2
#
# Credentials come from your normal logins, never from files in this repo:
#   AWS: `aws configure` / `aws sso login` / AWS_PROFILE        GCP: `gcloud auth application-default login`
set -euo pipefail
cd "$(dirname "$0")"

target=${1:-}; shift || true
gpu=false
while [ $# -gt 0 ]; do
  case $1 in
    --gpu) gpu=true; shift ;;
    --) shift; break ;;
    *) echo "unknown option: $1" >&2; exit 1 ;;
  esac
done

case $target in
  aws) only=(-only=amazon-ebs.fedora) ;;
  gcp) only=(-only=googlecompute.fedora) ;;
  all) only=() ;;
  *) sed -n '2,9p' "$0"; exit 1 ;;
esac

for cmd in packer ansible-playbook; do
  command -v "$cmd" >/dev/null || { echo "missing $cmd (macOS: brew install packer ansible)" >&2; exit 1; }
done

if [ "$target" != gcp ]; then
  aws sts get-caller-identity >/dev/null || { echo "not logged in to AWS (aws configure / aws sso login)" >&2; exit 1; }
fi
if [ "$target" != aws ]; then
  : "${GCP_PROJECT_ID:?set GCP_PROJECT_ID (e.g. export GCP_PROJECT_ID=\$(gcloud config get-value project))}"
  gcloud auth application-default print-access-token >/dev/null 2>&1 \
    || { echo "run: gcloud auth application-default login" >&2; exit 1; }
fi

# The playbook: a sibling checkout if you have one, otherwise the public repo.
ansible_dir=${ANSIBLE_DIR:-../ajf-fedora-workstation-ansible}
if [ ! -f "$ansible_dir/playbook.yml" ]; then
  ansible_dir=.ansible-src
  repo=${ANSIBLE_REPO_URL:-https://github.com/aaronfeingold/ajf-fedora-workstation-ansible.git}
  if [ -d "$ansible_dir/.git" ]; then git -C "$ansible_dir" pull -q; else git clone -q --depth 1 "$repo" "$ansible_dir"; fi
fi

packer init . >/dev/null
exec packer build ${only[@]+"${only[@]}"} -var "gpu=$gpu" -var "ansible_dir=$ansible_dir" "$@" .
